<Page
    x:Class="WinTweaker.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:WinTweaker.Models"
    Title="日志">

    <Grid Margin="0,16,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="清空日志" Command="{Binding ClearLogsCommand}"
                       Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}" />
            <ui:Button Content="复制全部" Command="{Binding CopyLogsCommand}"
                       Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}" />
        </StackPanel>

        <!-- 日志列表 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LogEntry}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding FormattedTime}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LevelTag}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                                            <Setter Property="Foreground" Value="#27AE60" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                            <Setter Property="Foreground" Value="#F39C12" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                            <Setter Property="Foreground" Value="#E74C3C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Info}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
