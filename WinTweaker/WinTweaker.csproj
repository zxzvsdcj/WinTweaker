<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <AssemblyName>WinTweaker</AssemblyName>
    <RootNamespace>WinTweaker</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>WinTweaker</Authors>
    <Description>Windows 全版本系统开发者优化工具</Description>
  </PropertyGroup>

  <!-- ============================================================
       双模式发布配置说明：
       
       模式一（轻量框架依赖版）：dotnet publish -c Release -p:PublishProfile=Light
       输出目录：publish-light/  体积：3-8MB
       要求目标机器已安装 .NET 9 Desktop Runtime x64
       
       模式二（自包含完整版）：dotnet publish -c Release -p:PublishProfile=Full
       输出目录：publish-full/  体积：55-80MB
       目标机器无需任何运行库
       ============================================================ -->

  <!-- 通用发布属性 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Platform>x64</Platform>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
